{
	"$schema": "https://json-schema.org/draft/2019-09/schema",
	"definitions": {
		"common": {
			"type": "object",
			"properties": {
				"delay": { "type": "number", "minimum": 0 },
				"waitLimit": { "type": "number", "minimum": 0 },
				"tag": { "type": "string" }
			}
		},
		"ubxLikeMsg": {
			"type": "object",
			"properties": {
				"class": { "type": "integer", "minimum": 0, "maximum": 255 },
				"id": { "type": "integer", "minimum": 0, "maximum": 255 },
				"payload": {
					"type": "object",
					"properties": {
						"types": { "type": "string", "pattern": "^([UI][124]|R[48])*$" },
						"values": { "type": "array", "items": { "type": "number" } }
					},
					"additionalProperties": false
				},
				"description": { "type": "string" }
			},
			"required": ["class", "id"],
			"allOf": [
				{ "$ref": "#/definitions/common" }
			],
			"unevaluatedProperties": false
		}
	},
	"type": "object",
	"properties": {
		"default": {
			"type": "object",
			"properties": {
				"line": {
					"type": "object",
					"properties": {
						"eol": { "type": "string" },
						"responsePattern": { "type": "string", "enum": ["none", "unicore"] }
					},
					"allOf": [
						{ "$ref": "#/definitions/common" }
					],
					"unevaluatedProperties": false
				},
				"binary": { "$ref": "#/definitions/common" },
				"nmea": { "$ref": "#/definitions/common" },
				"casbin": { "$ref": "#/definitions/common" },
				"ubx": { "$ref": "#/definitions/common" },
				"ubxval": { "$ref": "#/definitions/common" },
				"ubxvalport": { "$ref": "#/definitions/common" },
				"asbin": { "$ref": "#/definitions/common" },
				"sdbp": { "$ref": "#/definitions/common" }
			},
			"additionalProperties": false
		},
		"line": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"text": { "type": "string" },
					"eol": { "type": "string" },
					"responsePattern": { "type": "string", "enum": ["none", "unicore"] },
					"description": { "type": "string" }
				},
				"required": ["text"],
				"allOf": [
					{ "$ref": "#/definitions/common" }
				],
				"unevaluatedProperties": false
			}
		},
		"binary": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"hex": { "type": "string", "pattern": "^[0-9A-Fa-f \\t]*$" },
					"description": { "type": "string" }
				},
				"required": ["hex"],
				"allOf": [
					{ "$ref": "#/definitions/common" }
				],
				"unevaluatedProperties": false
			}
		},
		"nmea": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"text": { "type": "string" },
					"description": { "type": "string" }
				},
				"required": ["text"],
				"allOf": [
					{ "$ref": "#/definitions/common" }
				],
				"unevaluatedProperties": false
			}
		},
		"casbin": {
			"type": "array",
			"items": { "$ref": "#/definitions/ubxLikeMsg" }
		},
		"ubx": {
			"type": "array",
			"items": { "$ref": "#/definitions/ubxLikeMsg" }
		},
		"ubxval": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"keys": {
						"type": "array",
						"items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
					},
					"types": { "type": "string", "pattern": "^([UI][124]|R[48])*$" },
					"values": { "type": "array", "items": { "type": "number" } },
					"description": { "type": "string" }
				},
				"required": ["keys", "types", "values"],
				"allOf": [
					{ "$ref": "#/definitions/common" }
				],
				"unevaluatedProperties": false
			}
		},
		"ubxvalport": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"key": {
						"type": "object",
						"properties": {
							"i2c":   { "type": "integer", "minimum": 0, "maximum": 4294967295 },
							"uart1": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
							"uart2": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
							"usb":   { "type": "integer", "minimum": 0, "maximum": 4294967295 },
							"spi":   { "type": "integer", "minimum": 0, "maximum": 4294967295 }
						},
						"additionalProperties": false,
						"minProperties": 1
					},
					"value": { "type": "integer", "minimum": 0, "maximum": 255 },
					"description": { "type": "string" }
				},
				"required": ["key", "value"],
				"allOf": [
					{ "$ref": "#/definitions/common" }
				],
				"unevaluatedProperties": false
			}
		},
		"asbin": {
			"type": "array",
			"items": { "$ref": "#/definitions/ubxLikeMsg" }
		},
		"sdbp": {
			"type": "array",
			"items": { "$ref": "#/definitions/ubxLikeMsg" }
		},
		"include": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"src": { "type": "string", "minLength": 1 }
				},
				"required": ["src"],
				"additionalProperties": false
			}
		}
	},
	"additionalProperties": false
}
