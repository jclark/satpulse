{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"definitions": {
	  "proxyOptions": {
		"type": "object",
		"properties": {
		  "readOnly": { "type": "boolean" },
		  "nmeaOnly": { "type": "boolean" },
		  "writeLockTimeout": { "type": "number" }
		}
	  }
	},
	"type": "object",
	"properties": {
	  "serial": {
		"type": "object",
		"properties": {
		  "device": { "type": "string" },
		  "speed": { "type": "integer" }
		}
	  },
	  "gps": {
		"type": "object",
		"properties": {
		  "timeMode": { "type": "boolean" },
		  "resurvey": { "type": "boolean" },
		  "surveyTime": { "type": "integer" },
		  "surveyAcc": { "type": "number" }
		}
	  },
	  "phc": {
		"type": "object",
		"properties": {
		  "interface": { "type": "string" },
		  "pin": { "type": "integer" },
		  "channel": { "type": "integer" },
		  "wait": { "type": "boolean" }
		},
		"required": ["interface"]
	  },
	  "proxy": {
		"type": "object",
		"properties": {
		  "tcp": {
			"type": "array",
			"items": {
			  "type": "object",
			  "properties": {
				"listen": { "type": "string" }
			  },
			  "required": ["listen"],
			  "allOf": [
				{ "$ref": "#/definitions/proxyOptions" }
			  ]
			}
		  },
		  "socket": {
			"type": "array",
			"items": {
			  "type": "object",
			  "properties": {
				"path": { "type": "string" },
				"group": { "type": "string" }
			  },
			  "required": ["path"],
			  "allOf": [
				{ "$ref": "#/definitions/proxyOptions" }
			  ]
			}
		  }
		},
		"required": ["TCP", "Socket"]
	  },
	  "http": {
		"type": "array",
		"items": {
		  "type": "object",
		  "properties": {
			"listen": { "type": "string" }
		  },
		  "required": ["listen"]
		}
	  },
	  "leapSecond": {
		"type": "object",
		"properties": {
		  "date": { "type": "string", "format": "date" },
		  "before": { "type": "integer" },
		  "after": { "type": "integer" }
		},
		"required": ["date", "before", "after"]
	  },
	  "log": {
		"type": "object",
		"properties": {
		  "interval": { "type": "integer", "minimum": 0 },
		  "verbose": { "type": "boolean" },
		  "dir": { "type": "string" },
		  "clock": { "type": "boolean" }
		}
	  },
	  "ptp": {
		"type": "object",
		"properties": {		  
		  "domainNumber": { "type": "integer" },
		  "majorSdoId": { "type": "integer" },
		  "minorSdoId": { "type": "integer" },
		  "ptp4l": {
			"type": "object",
			"properties": {
				"udsAddress": { "type": "string" }
			},
			"required": ["udsAddress"]
		  }
		}
	  },
	  "ntp": {
		"type": "object",
		"properties": {
			"sock": {
				"type": "object",
				"properties": {
					"path": { "type": "string" }
				},
				"required": ["path"]
			}
		}
	  }
	},
	"required": ["phc"]
}
