{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"definitions": {
	  "proxyOptions": {
		"type": "object",
		"properties": {
		  "readOnly": { "type": "boolean" },
		  "protocol": {
			"type": "string",
			"enum": ["NMEA", "UBX", "RTCM"]
		   },
		  "writeLockTimeout": { "type": "number" }
		}
	  }
	},
	"type": "object",
	"properties": {
	  "serial": {
		"type": "object",
		"properties": {
		  "device": { "type": "string" },
		  "speed": { "type": "integer" }
		}
	  },
	  "gps": {
		"type": "object",
		"properties": {
		  "config": { "type": "boolean" },
		  "timeGNSS": {
			"type": "string",
			"enum": ["GPS", "GAL", "Galileo", "BDS", "BeiDou", "GLO", "GLONASS"]
		  },
		  "mobile": { "type": "boolean" },
		  "resurvey": { "type": "boolean" },
		  "surveyTime": { "type": "integer" },
		  "surveyAcc": { "type": "number" },
		  "fixedPosAcc": { "type": "number" },
		  "fixedPosECEF": {
			"type": "array",
			"items": { "type": "number" },
			"minItems": 3,
			"maxItems": 3
		  },
		  "antennaCableDelay": { "type": "number" },
		  "antennaCableLength": { "type": "number" },
		  "antennaCableVF": { "type": "number" },
		  "satellitesOutput": { "type": "boolean" },
		  "rtcmOutput": { "type": "boolean"},
		  "vendor": {
			"type": "string",
			"enum": [
			  "Allystar",
			  "Bynav",
			  "ComNav",
			  "Furuno",
			  "MediaTek",
			  "NovAtel",
			  "Quectel",
			  "Septentrio",
			  "SinoGNSS",
			  "SkyTraq",
			  "Trimble",
			  "u-blox",
			  "Unicore"
			]
		  }
		}
	  },
	  "phc": {
		"type": "object",
		"properties": {
		  "interface": { "type": "string" },
		  "pin": { "type": "integer", "minimum": 0 },
		  "channel": { "type": "integer", "minimum": 0 },
		  "wait": { "type": "boolean" }
		}
	  },
	  "proxy": {
		"type": "object",
		"properties": {
		  "tcp": {
			"type": "array",
			"items": {
			  "type": "object",
			  "properties": {
				"listen": { "type": "string" }
			  },
			  "required": ["listen"],
			  "allOf": [
				{ "$ref": "#/definitions/proxyOptions" }
			  ]
			}
		  },
		  "socket": {
			"type": "array",
			"items": {
			  "type": "object",
			  "properties": {
				"path": { "type": "string" },
				"group": { "type": "string" }
			  },
			  "required": ["path"],
			  "allOf": [
				{ "$ref": "#/definitions/proxyOptions" }
			  ]
			}
		  }
		}
	  },
	  "http": {
		"type": "array",
		"items": {
		  "type": "object",
		  "properties": {
			"listen": { "type": "string" },
			"gui": { "type": "boolean" },
			"metrics": { "type": "boolean" }
		  },
		  "required": ["listen"]
		}
	  },
	  "leapSecond": {
		"type": "object",
		"properties": {
		  "date": { "type": "string", "format": "date" },
		  "before": { "type": "integer" },
		  "after": { "type": "integer" }
		},
		"required": ["date", "before", "after"]
	  },
	  "log": {
		"type": "object",
		"properties": {
		  "interval": { "type": "integer", "minimum": 0 },
		  "verbose": { "type": "boolean" },
		  "dir": { "type": "string" },
		  "clock": { "type": "boolean" },
		  "event": { "type": "boolean" },
		  "packet": { "type": "boolean" },
		  "track": { "type": "boolean" }
		}
	  },
	  "ptp": {
		"type": "object",
		"properties": {
		  "clockAccuracy": { "type": "integer", "minimum": 0, "maximum": 1000 },		  
		  "domainNumber": { "type": "integer" },
		  "majorSdoId": { "type": "integer" },
		  "minorSdoId": { "type": "integer" },
		  "ptp4l": {
			"type": "object",
			"properties": {
				"udsAddress": { "type": "string" }
			},
			"required": ["udsAddress"]
		  }
		}
	  },
	  "ntp": {
		"type": "object",
		"properties": {
			"sock": {
				"type": "object",
				"properties": {
					"path": { "type": "string" }
				},
				"required": ["path"]
			}
		}
	  },
	  "sync": {
		"type": "object",
		"properties": {
		  "reset": {
			"type": "object",
			"properties": {
			  "pulseWindow": { "type": "integer", "minimum": 3, "exclusiveMaximum": 100 },
			  "stepThreshold": { "type": "integer", "minimum": 0, "exclusiveMaximum": 1000000 },
			  "pulseVariation": { "type": "number", "minimum": 5, "exclusiveMaximum": 1000000 },
			  "expectedDelay": { "type": "number", "minimum": 0.0, "exclusiveMaximum": 1.0 },
			  "delayConfidenceWindow": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0 },
			  "delayVariation": { "type": "number", "exclusiveMinimum": 0.0, "exclusiveMaximum": 1.0 },
			  "pulseWidthDetectLimit": { "type": "number", "minimum": 0.1, "exclusiveMaximum": 0.5 },
			  "driftRateLimit": { "type": "number", "minimum": 0, "exclusiveMaximum": 1000000000 }
			}
		  },
		  "converge": {
			"type": "object",
			"properties": {
			  "kp": { "type": "number", "exclusiveMinimum": 0.0, "exclusiveMaximum": 10.0 },
			  "ki": { "type": "number", "minimum": 0.0, "exclusiveMaximum": 10.0 },
			  "medianWindow": { "type": "integer", "minimum": 3, "exclusiveMaximum": 100 },
			  "offsetLimit": { "type": "integer", "exclusiveMinimum": 0, "maximum": 10000 },
			  "stableWindow": { "type": "integer", "minimum": 1, "exclusiveMaximum": 100 },
			  "badSampleLimit": { "type": "integer", "minimum": 1, "exclusiveMaximum": 100 },
			  "stepCompensate": { "type": "boolean" }
			}
		  },
		  "track": {
			"type": "object",
			"properties": {
			  "kp": { "type": "number", "exclusiveMinimum": 0.0, "exclusiveMaximum": 10.0 },
			  "ki": { "type": "number", "exclusiveMinimum": 0.0, "exclusiveMaximum": 10.0 },
			  "madThreshold": { "type": "integer", "exclusiveMinimum": 0, "maximum": 1000000 },
			  "madWindow": { "type": "integer", "minimum": 3, "exclusiveMaximum": 100 },
			  "madMultiple": { "type": "number", "exclusiveMinimum": 0.0, "exclusiveMaximum": 1000.0 },
			  "madMinSamples": { "type": "integer", "minimum": 3, "exclusiveMaximum": 100 },
			  "outlierThreshold": { "type": "integer", "exclusiveMinimum": 0, "maximum": 1000000 },
			  "pulseWidthTolerance": { "type": "integer", "exclusiveMinimum": 0, "maximum": 10000 },
			  "alignTolerance": { "type": "integer", "exclusiveMinimum": 0, "maximum": 10000 },
			  "badSampleRunLimit": { "type": "integer", "minimum": 1, "exclusiveMaximum": 1000 },
			  "outlierRatioLimit": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0 },
			  "badSampleWindow": { "type": "integer", "minimum": 1, "exclusiveMaximum": 1000 },
			  "badSampleRatioLimit": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0 },
			  "avgFreqTimeConstant": { "type": "number", "minimum": 0.0, "exclusiveMaximum": 1000.0 },
			  "ignoreSawtoothCorrection": { "type": "boolean" },
			  "pulseCorrectionTimeout": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 0.75 },
			  "persistThreshold": { "type": "number", "minimum": 0, "exclusiveMaximum": 86400 }
			}
		  }
		}
	  }
	}
}
