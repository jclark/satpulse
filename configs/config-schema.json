{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "proxyOptions": {
      "type": "object",
      "properties": {
        "readOnly": {
          "type": "boolean"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "NMEA",
            "UBX",
            "RTCM",
            "CASBIN",
            "ASBIN",
            "SDBP",
            "UNCB",
            "UNCA",
            "NOVB",
            "NOVA"
          ]
        },
        "writeLockTimeout": {
          "type": "number"
        }
      }
    }
  },
  "type": "object",
  "properties": {
    "user": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "User name",
            "type": "string"
          },
          "password": {
            "description": "Password",
            "type": "string"
          }
        },
        "required": ["name"]
      }
    },
    "serial": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string"
        },
        "speed": {
          "type": "integer"
        },
        "pps": {
          "type": "object",
          "properties": {
            "pin": {
              "type": "string",
              "enum": ["cts", "dcd", "dsr", "ri"]
            }
          },
          "required": ["pin"]
        }
      }
    },
    "sample": {
      "type": "object",
      "properties": {
        "serial": {
          "type": "object",
          "properties": {
            "pps": {
              "type": "object",
              "properties": {
                "delayUncertainty": {
                  "description": "Uncertainty in measured pulse-to-message delay (s)",
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 1,
                  "default": 0.005
                },
                "maxDelay": {
                  "description": "Maximum post-pulse message delay (s)",
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1,
                  "default": 0.8
                },
                "maxWakeupLatency": {
                  "description": "Maximum CPU wakeup latency while serial PPS is active (microseconds)",
                  "type": "number",
                  "minimum": 0
                },
                "method": {
                  "description": "PPS edge detection method: poll, wait, or kernel; omit for automatic selection",
                  "type": "string",
                  "enum": ["poll", "wait", "kernel"]
                }
              }
            }
          }
        }
      }
    },
    "gps": {
      "type": "object",
      "properties": {
        "config": {
          "type": "boolean",
          "default": false
        },
        "timeGNSS": {
          "type": "string",
          "enum": [
            "GPS",
            "GAL",
            "Galileo",
            "BDS",
            "BeiDou",
            "GLO",
            "GLONASS"
          ]
        },
        "mobile": {
          "type": "boolean",
          "default": false
        },
        "resurvey": {
          "type": "boolean",
          "default": false
        },
        "surveyTime": {
          "type": "integer",
          "default": 2000
        },
        "surveyAcc": {
          "type": "number",
          "default": 20
        },
        "fixedPosAcc": {
          "type": "number",
          "default": 20
        },
        "fixedPosECEF": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "fixedPosLLH": {
          "type": "array",
          "items": [
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -500,
              "maximum": 10000
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "minElevation": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "rtcmBaseID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "antennaCableDelay": {
          "type": "number"
        },
        "antennaCableLength": {
          "type": "number"
        },
        "antennaCableVF": {
          "type": "number",
          "default": 0.66
        },
        "satellitesOutput": {
          "type": "boolean"
        },
        "rtcmOutput": {
          "type": "boolean"
        },
        "rtcmPreferMSM7": {
          "type": "boolean"
        },
        "vendor": {
          "type": "string",
          "enum": [
            "Allystar",
            "Bynav",
            "ComNav",
            "Furuno",
            "MediaTek",
            "NovAtel",
            "Quectel",
            "Septentrio",
            "SinoGNSS",
            "SkyTraq",
            "Techtotop",
            "Trimble",
            "u-blox",
            "Unicore",
            "Zhongke",
            "other"
          ]
        }
      }
    },
    "phc": {
      "type": "object",
      "properties": {
        "interface": {
          "type": "string"
        },
        "pin": {
          "type": "integer",
          "minimum": 0
        },
        "channel": {
          "type": "integer",
          "minimum": 0
        },
        "wait": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "proxy": {
      "type": "object",
      "properties": {
        "tcp": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "listen": {
                "type": "string"
              }
            },
            "required": [
              "listen"
            ],
            "allOf": [
              {
                "$ref": "#/definitions/proxyOptions"
              }
            ]
          }
        },
        "socket": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "group": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "allOf": [
              {
                "$ref": "#/definitions/proxyOptions"
              }
            ]
          }
        }
      }
    },
    "http": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "listen": {
            "type": "string"
          },
          "gui": {
            "type": "boolean",
            "default": true
          },
          "metrics": {
            "type": "boolean",
            "default": true
          },
          "position": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "listen"
        ]
      }
    },
    "leapSecond": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "before": {
          "type": "integer"
        },
        "after": {
          "type": "integer"
        }
      },
      "required": [
        "date",
        "before",
        "after"
      ]
    },
    "log": {
      "type": "object",
      "properties": {
        "interval": {
          "type": "integer",
          "default": 30,
          "minimum": 0
        },
        "verbose": {
          "type": "boolean",
          "default": false
        },
        "dir": {
          "type": "string",
          "default": "/var/log/satpulse"
        },
        "clock": {
          "type": "boolean",
          "default": false
        },
        "event": {
          "type": "boolean",
          "default": false
        },
        "packet": {
          "type": "boolean",
          "default": false
        },
        "track": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "ptp": {
      "type": "object",
      "properties": {
        "clockAccuracy": {
          "type": "integer",
          "default": 150,
          "minimum": 0,
          "maximum": 1000
        },
        "offsetScaledLogVariance": {
          "type": "integer",
          "default": 65535,
          "minimum": 0,
          "maximum": 65535
        },
        "allanDeviation": {
          "type": "number"
        },
        "domainNumber": {
          "type": "integer"
        },
        "majorSdoId": {
          "type": "integer"
        },
        "minorSdoId": {
          "type": "integer"
        },
        "ptp4l": {
          "type": "object",
          "properties": {
            "udsAddress": {
              "type": "string"
            }
          },
          "required": [
            "udsAddress"
          ]
        }
      }
    },
    "ntp": {
      "type": "object",
      "properties": {
        "sock": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        },
        "shm": {
          "type": "object",
          "properties": {
            "segment": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "precision": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            }
          }
        }
      }
    },
    "ntrip": {
      "type": "object",
      "properties": {
        "listen": {
          "description": "TCP listen address",
          "type": "string",
          "default": ":2101"
        },
        "country": {
          "description": "ISO 3166 country code shown in the source table",
          "type": "string",
          "default": "XXX"
        },
        "network": {
          "description": "Network name shown in the source table",
          "type": "string",
          "default": "Misc"
        },
        "lat": {
          "description": "Latitude override; default derived from receiver fixed position",
          "type": "number"
        },
        "lon": {
          "description": "Longitude override; default derived from receiver fixed position",
          "type": "number"
        },
        "generator": {
          "description": "Generator string; default receiver hardware or satpulse version",
          "type": "string"
        },
        "formatDetails": {
          "description": "RTCM message list override; default synthesised from enabled GNSS",
          "type": "string"
        },
        "bitrate": {
          "description": "Default per-mountpoint bitrate",
          "type": "integer",
          "default": 0,
          "minimum": 0
        },
        "mountpoint": {
          "description": "Mountpoints served by the caster",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "description": "Mountpoint name (URL path component)",
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,100}$"
              },
              "description": {
                "description": "Mountpoint description shown in the source table (default = name)",
                "type": "string"
              },
              "bitrate": {
                "description": "Bitrate shown in the source table for this mountpoint",
                "type": "integer",
                "minimum": 0
              },
              "auth": {
                "description": "Authentication, if any, for this mountpoint",
                "type": "object",
                "properties": {
                  "anyUser": {
                    "description": "Allow any valid user",
                    "type": "boolean"
                  },
                  "users": {
                    "description": "Restrict access to these users",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "not": {
                  "properties": {
                    "anyUser": {"const": true},
                    "users": {"minItems": 1}
                  },
                  "required": ["anyUser", "users"]
                }
              },
              "msm7to4": {
                "description": "Convert MSM7 packets to MSM4 before sending",
                "type": "boolean",
                "default": false
              }
            },
            "required": ["name"]
          }
        }
      }
    },
    "stream": {
      "type": "object",
      "properties": {
        "pull": {
          "description": "Network correction source written to the receiver. Configure at most one of tcp or ntrip; an empty table leaves it disabled.",
          "type": "object",
          "properties": {
            "tcp": {
              "description": "Plain TCP correction source",
              "type": "object",
              "properties": {
                "address": {
                  "description": "host:port of the correction source",
                  "type": "string"
                }
              },
              "required": ["address"]
            },
            "ntrip": {
              "description": "Ntrip v1 caster client",
              "type": "object",
              "properties": {
                "address": {
                  "description": "host[:port] of the Ntrip caster (default port 2101)",
                  "type": "string"
                },
                "mountpoint": {
                  "description": "Caster mountpoint to subscribe to",
                  "type": "string"
                },
                "username": {
                  "description": "Username for basic authentication",
                  "type": "string"
                },
                "password": {
                  "description": "Password for basic authentication",
                  "type": "string"
                },
                "nmeaSend": {
                  "description": "Send the receiver position as NMEA GGA to the caster",
                  "type": "boolean",
                  "default": false
                },
                "nmeaSendInterval": {
                  "description": "Seconds between NMEA GGA uploads; 0 sends once per connection",
                  "type": "number",
                  "default": 5,
                  "oneOf": [
                    {"const": 0},
                    {"minimum": 1}
                  ]
                }
              },
              "required": ["address", "mountpoint"]
            }
          },
          "not": {"required": ["tcp", "ntrip"]}
        },
        "push": {
          "description": "Outbound stream destinations. Each entry forwards scanned packets to a remote endpoint.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "protocol": {
                "description": "Packet format to forward",
                "type": "string",
                "enum": ["", "RTCM", "NMEA", "UBX", "CASBIN", "ASBIN", "SDBP", "UNCB", "UNCA", "NOVB", "NOVA"]
              },
              "ntrip": {
                "description": "Ntrip v1 server (SOURCE) upload to a remote caster",
                "type": "object",
                "properties": {
                  "address": {
                    "description": "host[:port] of the remote caster (default port 2101)",
                    "type": "string"
                  },
                  "mountpoint": {
                    "description": "Mountpoint name to push to on the remote caster",
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]{1,100}$"
                  },
                  "password": {
                    "description": "Password authenticating the SOURCE upload (printable ASCII, no whitespace)",
                    "type": "string",
                    "pattern": "^[\\x21-\\x7E]+$"
                  },
                  "description": {
                    "description": "Description used in the STR header (defaults to mountpoint)",
                    "type": "string",
                    "pattern": "^[^;\\r\\n]*$"
                  },
                  "bitrate": {
                    "description": "Bitrate used in the STR header for this stream",
                    "type": "integer",
                    "minimum": 0
                  },
                  "msm7to4": {
                    "description": "Convert MSM7 packets to MSM4 before sending (RTCM only)",
                    "type": "boolean"
                  }
                },
                "required": ["address", "mountpoint", "password"]
              },
              "udp": {
                "description": "UDP packet stream destination",
                "type": "object",
                "properties": {
                  "address": {
                    "description": "host:port of the UDP destination",
                    "type": "string"
                  }
                },
                "required": ["address"]
              }
            },
            "oneOf": [
              {"required": ["ntrip"]},
              {"required": ["udp"]}
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "protocol": {"enum": ["NMEA", "UBX", "CASBIN", "ASBIN", "SDBP", "UNCB", "UNCA", "NOVB", "NOVA"]}
                  },
                  "required": ["protocol"]
                },
                "then": {
                  "properties": {
                    "ntrip": {
                      "properties": {
                        "msm7to4": {"const": false}
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "sync": {
      "type": "object",
      "properties": {
        "reset": {
          "description": "Reset mode parameters",
          "type": "object",
          "properties": {
            "pulseWindow": {
              "description": "Number of pulses for alignment analysis",
              "type": "integer",
              "default": 5,
              "minimum": 3,
              "exclusiveMaximum": 100
            },
            "stepThreshold": {
              "description": "Min offset to trigger clock step (ns)",
              "type": "integer",
              "default": 5000,
              "minimum": 0,
              "exclusiveMaximum": 1000000
            },
            "pulseVariation": {
              "description": "Max pulse interval variation (ppb)",
              "type": "number",
              "default": 500.0,
              "minimum": 5,
              "exclusiveMaximum": 1000000
            },
            "expectedDelay": {
              "description": "Expected pulse-to-message delay (s)",
              "type": "number",
              "default": 0.1,
              "minimum": 0.0,
              "exclusiveMaximum": 1.0
            },
            "delayConfidenceWindow": {
              "description": "Fraction of delay window to accept [0,1]",
              "type": "number",
              "default": 0.6,
              "exclusiveMinimum": 0.0,
              "maximum": 1.0
            },
            "delayVariation": {
              "description": "Max delay spread as fraction of window",
              "type": "number",
              "default": 0.2,
              "exclusiveMinimum": 0.0,
              "exclusiveMaximum": 1.0
            },
            "pulseWidthDetectLimit": {
              "description": "Max auto-detectable pulse width (s)",
              "type": "number",
              "default": 0.45,
              "minimum": 0.1,
              "exclusiveMaximum": 0.5
            },
            "driftRateLimit": {
              "description": "Max drift rate to accept step (PPB)",
              "type": "number",
              "default": 100000,
              "minimum": 0,
              "exclusiveMaximum": 1000000000
            }
          }
        },
        "converge": {
          "description": "Converging mode parameters",
          "type": "object",
          "properties": {
            "kp": {
              "description": "PI servo proportional gain",
              "type": "number",
              "default": 0.7,
              "exclusiveMinimum": 0.0,
              "exclusiveMaximum": 10.0
            },
            "ki": {
              "description": "PI servo integral gain",
              "type": "number",
              "default": 0.3,
              "minimum": 0.0,
              "exclusiveMaximum": 10.0
            },
            "medianWindow": {
              "description": "Number of samples for median window",
              "type": "integer",
              "default": 5,
              "minimum": 3,
              "exclusiveMaximum": 100
            },
            "offsetLimit": {
              "description": "Max offset to declare converged (ns)",
              "type": "integer",
              "default": 1000,
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            "stableWindow": {
              "description": "Number of stable samples before exit",
              "type": "integer",
              "default": 3,
              "minimum": 1,
              "exclusiveMaximum": 100
            },
            "badSampleLimit": {
              "description": "Max consecutive bad samples before reset",
              "type": "integer",
              "default": 3,
              "minimum": 1,
              "exclusiveMaximum": 100
            },
            "stepCompensate": {
              "description": "Compensate for ADJ_SETOFFSET delay",
              "type": "boolean",
              "default": true
            }
          }
        },
        "track": {
          "description": "Tracking mode parameters",
          "type": "object",
          "properties": {
            "kp": {
              "description": "PI servo proportional gain",
              "type": "number",
              "default": 0.8,
              "exclusiveMinimum": 0.0,
              "exclusiveMaximum": 10.0
            },
            "ki": {
              "description": "PI servo integral gain",
              "type": "number",
              "default": 0.3,
              "exclusiveMinimum": 0.0,
              "exclusiveMaximum": 10.0
            },
            "madThreshold": {
              "description": "Min offset to use MAD for outlier detection (ns)",
              "type": "integer",
              "default": 50,
              "exclusiveMinimum": 0,
              "maximum": 1000000
            },
            "madWindow": {
              "description": "Number of samples for MAD window",
              "type": "integer",
              "default": 20,
              "minimum": 3,
              "exclusiveMaximum": 100
            },
            "madMultiple": {
              "description": "MAD multiple for outlier threshold",
              "type": "number",
              "default": 25.0,
              "exclusiveMinimum": 0.0,
              "exclusiveMaximum": 1000.0
            },
            "madMinSamples": {
              "description": "Min samples before MAD detection active",
              "type": "integer",
              "default": 10,
              "minimum": 3,
              "exclusiveMaximum": 100
            },
            "outlierThreshold": {
              "description": "Unconditional outlier threshold (ns)",
              "type": "integer",
              "default": 500,
              "exclusiveMinimum": 0,
              "maximum": 1000000
            },
            "pulseWidthTolerance": {
              "description": "Tolerance for trailing edge filter (ns)",
              "type": "integer",
              "default": 200,
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            "alignTolerance": {
              "description": "Tolerance for leading edge detection (ns)",
              "type": "integer",
              "default": 100,
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            "badSampleRunLimit": {
              "description": "Max consecutive bad samples before reset",
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "exclusiveMaximum": 1000
            },
            "outlierRatioLimit": {
              "description": "Max outlier ratio in MAD window",
              "type": "number",
              "default": 0.3,
              "exclusiveMinimum": 0.0,
              "maximum": 1.0
            },
            "badSampleWindow": {
              "description": "Window size for bad sample frequency",
              "type": "integer",
              "default": 60,
              "minimum": 1,
              "exclusiveMaximum": 1000
            },
            "badSampleRatioLimit": {
              "description": "Max bad sample ratio in window",
              "type": "number",
              "default": 0.5,
              "exclusiveMinimum": 0.0,
              "maximum": 1.0
            },
            "avgFreqTimeConstant": {
              "description": "EMA time constant for avg frequency (s)",
              "type": "number",
              "default": 30,
              "minimum": 0.0,
              "exclusiveMaximum": 1000.0
            },
            "ignoreSawtoothCorrection": {
              "description": "Ignore sawtooth corrections",
              "type": "boolean",
              "default": false
            },
            "pulseCorrectionTimeout": {
              "description": "Max wait for pulse correction msg (s)",
              "type": "number",
              "default": 0.3,
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 0.75
            },
            "persistThreshold": {
              "description": "Min time in tracking before sample persists (s)",
              "type": "number",
              "default": 900,
              "minimum": 0,
              "exclusiveMaximum": 86400
            }
          }
        },
        "share": {
          "description": "Cross-mode parameters",
          "type": "object",
          "properties": {
            "detectInvalidLeap": {
              "description": "Enable detection of invalid leap seconds after reset mode completes",
              "type": "boolean",
              "default": true
            },
            "minInvalidRepeatInterval": {
              "description": "Min repeat interval to declare invalid leap (s)",
              "type": "number",
              "default": 0.8,
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1.0
            }
          }
        }
      }
    }
  }
}
