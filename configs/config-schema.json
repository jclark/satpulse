{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"definitions": {
	  "proxyOptions": {
		"type": "object",
		"properties": {
		  "readOnly": { "type": "boolean" },
		  "protocol": {
			"type": "string",
			"enum": ["NMEA", "UBX", "RTCM"]
		   },
		  "writeLockTimeout": { "type": "number" }
		}
	  }
	},
	"type": "object",
	"properties": {
	  "serial": {
		"type": "object",
		"properties": {
		  "device": { "type": "string" },
		  "speed": { "type": "integer" }
		}
	  },
	  "gps": {
		"type": "object",
		"properties": {
		  "config": { "type": "boolean" },
		  "pulseWidth": {
			"type": "number",
			"exclusiveMinimum": 0,
			"exclusiveMaximum": 1
		  },
		  "timeGNSS": {
			"type": "string",
			"enum": ["GPS", "GAL", "Galileo", "BDS", "BeiDou", "GLO", "GLONASS"]
		  },
		  "mobile": { "type": "boolean" },
		  "resurvey": { "type": "boolean" },
		  "surveyTime": { "type": "integer" },
		  "surveyAcc": { "type": "number" },
		  "fixedPosAcc": { "type": "number" },
		  "fixedPosECEF": {
			"type": "array",
			"items": { "type": "number" },
			"minItems": 3,
			"maxItems": 3
		  },
		  "antennaCableDelay": { "type": "number" },
		  "antennaCableLength": { "type": "number" },
		  "antennaCableVF": { "type": "number" },
		  "satellitesOutput": { "type": "boolean" },
		  "rtcmOutput": { "type": "boolean"},
		  "nmeaNumbering": {
			"type": "string",
			"enum": ["u-blox", "allystar"]
		  }
		}
	  },
	  "phc": {
		"type": "object",
		"properties": {
		  "interface": { "type": "string" },
		  "pin": { "type": "integer", "minimum": 0 },
		  "channel": { "type": "integer", "minimum": 0 },
		  "wait": { "type": "boolean" }
		}
	  },
	  "proxy": {
		"type": "object",
		"properties": {
		  "tcp": {
			"type": "array",
			"items": {
			  "type": "object",
			  "properties": {
				"listen": { "type": "string" }
			  },
			  "required": ["listen"],
			  "allOf": [
				{ "$ref": "#/definitions/proxyOptions" }
			  ]
			}
		  },
		  "socket": {
			"type": "array",
			"items": {
			  "type": "object",
			  "properties": {
				"path": { "type": "string" },
				"group": { "type": "string" }
			  },
			  "required": ["path"],
			  "allOf": [
				{ "$ref": "#/definitions/proxyOptions" }
			  ]
			}
		  }
		}
	  },
	  "http": {
		"type": "array",
		"items": {
		  "type": "object",
		  "properties": {
			"listen": { "type": "string" }
		  },
		  "required": ["listen"]
		}
	  },
	  "leapSecond": {
		"type": "object",
		"properties": {
		  "date": { "type": "string", "format": "date" },
		  "before": { "type": "integer" },
		  "after": { "type": "integer" }
		},
		"required": ["date", "before", "after"]
	  },
	  "log": {
		"type": "object",
		"properties": {
		  "interval": { "type": "integer", "minimum": 0 },
		  "verbose": { "type": "boolean" },
		  "dir": { "type": "string" },
		  "clock": { "type": "boolean" },
		  "event": { "type": "boolean" },
		  "packet": { "type": "boolean" }
		}
	  },
	  "ptp": {
		"type": "object",
		"properties": {
		  "clockAccuracy": { "type": "integer", "minimum": 0, "maximum": 1000 },		  
		  "domainNumber": { "type": "integer" },
		  "majorSdoId": { "type": "integer" },
		  "minorSdoId": { "type": "integer" },
		  "ptp4l": {
			"type": "object",
			"properties": {
				"udsAddress": { "type": "string" }
			},
			"required": ["udsAddress"]
		  }
		}
	  },
	  "ntp": {
		"type": "object",
		"properties": {
			"sock": {
				"type": "object",
				"properties": {
					"path": { "type": "string" }
				},
				"required": ["path"]
			}
		}
	  }
	}
}
