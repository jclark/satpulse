#!/bin/sh
# Commission a freshly imaged Raspberry Pi as a test host: runs newhost.yml.
# Run "newhost -h" for usage.

usage() {
  cat <<EOF
Usage: $0 [options] HOST [-- ANSIBLE-ARGS...]

Commission HOST, a Raspberry Pi freshly imaged with Raspberry Pi Imager, as
a SatPulse test host with a static address, using the newhost.yml playbook:
passwordless sudo, authorized keys, static address, UARTs, chrony, linuxptp,
reboot, then install.yml and config.yml. Afterwards start.yml and check.yml
can be run.

HOST has two names while it is commissioned: HOST.lan, the permanent name,
which DNS gives the static address the host is to have; and HOST.local, the
mDNS name the host announces at its temporary DHCP address. A HOST without
a domain name gets .lan appended.

Before running this:
  1. Add HOST.lan to DNS with its static address.
  2. Image the Pi with Raspberry Pi Imager: hostname HOST (short name),
     user and password, ssh enabled. Connect eth0 to the network and boot it.
  3. Add HOST.lan to inventory.yml: the install group plus its receiver
     settings, and any rpi_* settings (see newhost.yml). No ansible_host.

This script then looks up the static address of HOST.lan, connects to the
host as HOST.local (running ssh-copy-id if your key is not on it yet, which
prompts for the login password, and recording its host key under HOST.lan),
and runs the playbook, which prompts for the sudo password (-K). After the
reboot the host is on its static address and the playbook carries on there.
If HOST.lan already answers as HOST (running this again), it is used
throughout.

Options:
  -a, --address ADDR[/PREFIX]  static address to use instead of the DNS
                               address of HOST; PREFIX defaults to 24
  -d, --dhcp                   leave the host on DHCP (a temporary host)
  -v, --via ADDR               reach the host at ADDR until the reboot,
                               instead of HOST.local (for a host whose mDNS
                               name cannot be resolved from here)
  -s, --site-vars FILE         site variables file: authorized_keys,
                               chrony_sources, ipv4_gateway, ipv4_dns,
                               ipv4_search (see newhost.yml);
                               default \$SATPULSE_SITE_VARS
  -n, --dry-run                print the ansible-playbook command, don't run it
  -h, --help                   show this help

Arguments after -- are passed to ansible-playbook, e.g.
  -- -e '{"rpi_uart_overlays": ["uart3"]}'

Examples:
  $0 -s ~/site-vars.yml crottin
  $0 -s ~/site-vars.yml -v 10.56.65.101 crottin
  $0 -s ~/site-vars.yml -d chaource2
EOF
}

die() {
  echo "$0: $*" >&2
  echo "Try '$0 -h' for help." >&2
  exit 2
}

address=""
dhcp=false
via=""
site_vars="${SATPULSE_SITE_VARS:-}"
dry_run=false
host=""

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -a|--address) [ $# -ge 2 ] || die "$1 needs an argument"; address="$2"; shift 2 ;;
    --address=*) address="${1#*=}"; shift ;;
    -d|--dhcp) dhcp=true; shift ;;
    -v|--via) [ $# -ge 2 ] || die "$1 needs an argument"; via="$2"; shift 2 ;;
    --via=*) via="${1#*=}"; shift ;;
    -s|--site-vars) [ $# -ge 2 ] || die "$1 needs an argument"; site_vars="$2"; shift 2 ;;
    --site-vars=*) site_vars="${1#*=}"; shift ;;
    -n|--dry-run) dry_run=true; shift ;;
    --) shift; break ;;
    -*) die "unknown option: $1" ;;
    *) [ -z "$host" ] || die "only one HOST allowed"; host="$1"; shift ;;
  esac
done

[ -n "$host" ] || die "HOST is required"
[ -n "$site_vars" ] || die "--site-vars is required (or set SATPULSE_SITE_VARS)"
[ -f "$site_vars" ] || die "site variables file not found: $site_vars"
! $dhcp || [ -z "$address" ] || die "--address and --dhcp conflict"

case "$host" in
  *.*) ;;
  *) host="$host.lan" ;;
esac
short="${host%%.*}"

if ! $dhcp; then
  if [ -z "$address" ]; then
    address="$(python3 -c 'import socket, sys; print(socket.gethostbyname(sys.argv[1]))' "$host" 2>/dev/null)" \
      || die "$host is not in DNS: add it with its static address, or give --address"
  fi
  case "$address" in
    */*) ;;
    *) address="$address/24" ;;
  esac
  echo "$address" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$' \
    || die "not an IPv4 address with optional /PREFIX: $address"
fi

# Absolute, since we cd to the playbook directory
case "$site_vars" in
  /*) ;;
  *) site_vars="$(pwd)/$site_vars" ;;
esac

cd "$(dirname "$0")" || exit 1

hostvars="$(ansible-inventory -i inventory.yml --host "$host" 2>/dev/null)" \
  || die "$host is not in inventory.yml"
user="$(echo "$hostvars" | python3 -c 'import json, sys; print(json.load(sys.stdin).get("ansible_user", ""))')"
user_at="${user:+$user@}"

# Until the reboot, reach the host by its permanent name if that already
# answers as this host, else at its temporary address, with its host key
# recorded under the permanent name.
ssh_check="ssh -o BatchMode=yes -o ConnectTimeout=10"
if [ -z "$via" ]; then
  if [ "$($ssh_check "$user_at$host" hostname 2>/dev/null)" != "$short" ]; then
    via="$short.local"
  fi
fi
if [ -n "$via" ]; then
  ssh_opts="-o HostKeyAlias=$host"
  target="$user_at$via"
else
  ssh_opts=""
  target="$user_at$host"
fi

set -- ansible-playbook -K -i inventory.yml newhost.yml -l "$host" \
  -e "@$site_vars" ${address:+-e "ipv4_address=$address"} \
  ${via:+-e "newhost_via=$via"} "$@"

if $dry_run; then
  echo "$@"
  exit 0
fi

if ! $ssh_check $ssh_opts "$target" true 2>/dev/null; then
  echo "Key authentication to $target failed; running ssh-copy-id (enter the login password)."
  ssh-copy-id $ssh_opts "$target" \
    || die "cannot reach $target (if a re-imaged host has a new host key, ssh-keygen -R $host first; if $short.local does not resolve, use --via)"
fi

exec "$@"
