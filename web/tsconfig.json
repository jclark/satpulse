{
  "compilerOptions": {
    "target": "es2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "sourceMap": true,
    "outDir": "out",
    "strict": true,
    
    "forceConsistentCasingInFileNames": true,
    "lib": ["dom", "es2020"],
  },
  //"include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
