// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go
{
	"name": "Go",
	
	"build": {
		// Allow the Dockerfile to copy go.mod and go.sum.
		"context": "..",
        "dockerfile": "Dockerfile"
    },

	"features": {
  		"ghcr.io/devcontainers/features/node:2": { "version": "24" },
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},

	// This is so that gh can use credentials from the host machine.
	// This requires using `gh auth login --insecure-storage` on the host machine.
	"mounts": [
		"source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind",
		"source=${localEnv:HOME}/.npm,target=/home/vscode/.npm,type=bind",
		"source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind"
	],
	// This ensures that the mounts work even if there was no previous gh configuration.
	"initializeCommand": "[ -d ${HOME}/.config/gh ] || mkdir -p ${HOME}/.config/gh",
	
	"customizations": {
    	// Configure properties specific to VS Code.
    	"vscode": {
      		// Add the IDs of extensions you want installed when the container is created.
      		"extensions": [
				"ms-azuretools.vscode-docker",
				"ms-vscode.makefile-tools",
				"bradlc.vscode-tailwindcss"
			]
    	}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "git config --global --add safe.directory /workspaces/satpulse && npm ci --prefix webui"

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
