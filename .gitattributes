# TypeScript sources and generated golden files are written with LF.
# Force LF on checkout so byte-for-byte comparisons (e.g. gps/ts
# TestValidateGenTS) pass on Windows where autocrlf would otherwise
# convert them to CRLF.
*.ts text eol=lf

# The embedded web UI assets are generated by `go generate ./time/internal/web`
# and `go generate ./cmd/satpulsewb` (Vite build output). Mark them generated so
# GitHub collapses them in diffs.
time/internal/web/dist/** linguist-generated=true
cmd/satpulsewb/dist/** linguist-generated=true

# The embedded GPS message-file library is generated by `go generate ./gps/msgfile`.
gps/msgfile/gpsmsg.zip linguist-generated=true
