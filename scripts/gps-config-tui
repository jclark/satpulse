#!/bin/bash
# gps-config-tui - whiptail-based TUI for building satpulsetool gps commands
# Similar in spirit to raspi-config / nmtui

set -e

# --- State variables ---
CONN_TYPE=""       # "serial", "config", "socket"
SERIAL_DEVICE=""
DEVICE_SPEED=""
CONFIG_FILE=""
SOCKET_PATH=""

GNSS=""            # e.g. "GPS,GAL"
BAND=""            # e.g. "L1,L5"
MIN_ELEV=""

TIME_MODE=""       # "survey", "fixed", "mobile", ""
SURVEY_TIME=""
SURVEY_ACC=""
FIXED_POS=""       # X,Y,Z
FIXED_POS_ACC=""

PPS_WIDTH=""
ANT_CABLE_DELAY=""
TIME_GNSS=""

PVT_OUT=""
SATS_OUT=""
RAW_OUT=""
RTCM_OUT=""
RTCM_BASE_ID=""
NMEA_OUT=""
BINARY_NMEA=""     # "binary", "nmea", ""

RECEIVER_SPEED=""

SAVE_RESET=""      # "save", "save-all", "reload", "reset", "factory-reset", ""

WT_HEIGHT=20
WT_WIDTH=72
WT_MENU_HEIGHT=12

# --- Helpers ---

# Summary string for a config aspect, shown in main menu
conn_summary() {
    case "$CONN_TYPE" in
        serial)  echo "$SERIAL_DEVICE @ ${DEVICE_SPEED} bps" ;;
        config)  echo "from $CONFIG_FILE" ;;
        socket)  echo "socket $SOCKET_PATH" ;;
        *)       echo "no change" ;;
    esac
}

gnss_summary() {
    local parts=""
    [ -n "$GNSS" ] && parts="$GNSS"
    [ -n "$BAND" ] && parts="${parts:+$parts / }$BAND"
    [ -n "$MIN_ELEV" ] && parts="${parts:+$parts / }elev >= ${MIN_ELEV} deg"
    echo "${parts:-no change}"
}

timemode_summary() {
    case "$TIME_MODE" in
        survey)
            local parts="survey"
            [ -n "$SURVEY_TIME" ] && parts="$parts ${SURVEY_TIME}s"
            [ -n "$SURVEY_ACC" ] && parts="$parts acc ${SURVEY_ACC}m"
            echo "$parts"
            ;;
        fixed)
            local parts="fixed $FIXED_POS"
            [ -n "$FIXED_POS_ACC" ] && parts="$parts acc ${FIXED_POS_ACC}m"
            echo "$parts"
            ;;
        mobile) echo "mobile" ;;
        *)      echo "no change" ;;
    esac
}

timepulse_summary() {
    local parts=""
    [ -n "$PPS_WIDTH" ] && parts="width ${PPS_WIDTH}s"
    [ -n "$ANT_CABLE_DELAY" ] && parts="${parts:+$parts, }cable delay ${ANT_CABLE_DELAY}ns"
    [ -n "$TIME_GNSS" ] && parts="${parts:+$parts, }$TIME_GNSS"
    echo "${parts:-no change}"
}

messages_summary() {
    local parts=""
    [ -n "$BINARY_NMEA" ] && parts="$BINARY_NMEA"
    [ -n "$PVT_OUT" ] && parts="${parts:+$parts, }pvt: $PVT_OUT"
    [ -n "$NMEA_OUT" ] && parts="${parts:+$parts, }nmea: $NMEA_OUT"
    [ -n "$RTCM_OUT" ] && parts="${parts:+$parts, }rtcm: $RTCM_OUT"
    [ -n "$SATS_OUT" ] && parts="${parts:+$parts, }sats: $SATS_OUT"
    [ -n "$RAW_OUT" ] && parts="${parts:+$parts, }raw: $RAW_OUT"
    echo "${parts:-no change}"
}

save_summary() {
    case "$SAVE_RESET" in
        save)          echo "save changes" ;;
        save-all)      echo "save all" ;;
        reload)        echo "reload from NV memory" ;;
        reset)         echo "reset receiver" ;;
        factory-reset) echo "factory reset" ;;
        *)             echo "no change" ;;
    esac
}

# Build the satpulsetool gps command from current state
build_command() {
    local cmd="satpulsetool gps"
    case "$CONN_TYPE" in
        serial) cmd="$cmd -d $SERIAL_DEVICE -s $DEVICE_SPEED" ;;
        config) cmd="$cmd -f $CONFIG_FILE" ;;
        socket) cmd="$cmd --socket $SOCKET_PATH" ;;
    esac
    [ -n "$GNSS" ] && cmd="$cmd -g $GNSS"
    [ -n "$BAND" ] && cmd="$cmd -b $BAND"
    [ -n "$MIN_ELEV" ] && cmd="$cmd --min-elev $MIN_ELEV"
    case "$TIME_MODE" in
        survey)
            cmd="$cmd --survey"
            [ -n "$SURVEY_TIME" ] && cmd="$cmd --survey-time $SURVEY_TIME"
            [ -n "$SURVEY_ACC" ] && cmd="$cmd --survey-acc $SURVEY_ACC"
            ;;
        fixed)
            cmd="$cmd --fixed-pos-ecef $FIXED_POS"
            [ -n "$FIXED_POS_ACC" ] && cmd="$cmd --fixed-pos-acc $FIXED_POS_ACC"
            ;;
        mobile) cmd="$cmd --mobile" ;;
    esac
    [ -n "$PPS_WIDTH" ] && cmd="$cmd --pps $PPS_WIDTH"
    [ -n "$ANT_CABLE_DELAY" ] && cmd="$cmd --ant-cable-delay $ANT_CABLE_DELAY"
    [ -n "$TIME_GNSS" ] && cmd="$cmd --time-gnss $TIME_GNSS"
    [ "$BINARY_NMEA" = "binary" ] && cmd="$cmd --binary"
    [ "$BINARY_NMEA" = "nmea" ] && cmd="$cmd --nmea"
    [ -n "$PVT_OUT" ] && cmd="$cmd --pvt-out $PVT_OUT"
    [ -n "$SATS_OUT" ] && cmd="$cmd --sats-out $SATS_OUT"
    [ -n "$RAW_OUT" ] && cmd="$cmd --raw-out $RAW_OUT"
    [ -n "$RTCM_OUT" ] && cmd="$cmd --rtcm-out $RTCM_OUT"
    [ -n "$RTCM_BASE_ID" ] && cmd="$cmd --rtcm-base-id $RTCM_BASE_ID"
    [ -n "$NMEA_OUT" ] && cmd="$cmd --nmea-out $NMEA_OUT"
    [ -n "$RECEIVER_SPEED" ] && cmd="$cmd --speed $RECEIVER_SPEED"
    case "$SAVE_RESET" in
        save)          cmd="$cmd --save" ;;
        save-all)      cmd="$cmd --save-all" ;;
        reload)        cmd="$cmd --reload" ;;
        reset)         cmd="$cmd --reset" ;;
        factory-reset) cmd="$cmd --factory-reset" ;;
    esac
    echo "$cmd"
}

# --- Checklist helper ---

# Run a checklist with descriptions, return comma-separated result.
# Args: title, current_value, tag1, desc1, tag2, desc2, ...
checklist_csv() {
    local title="$1" current="$2"
    shift 2
    local args=()
    while [ $# -ge 2 ]; do
        local tag="$1" desc="$2"
        shift 2
        local state="OFF"
        case ",$current," in
            *",$tag,"*) state="ON" ;;
        esac
        args+=("$tag" "$desc" "$state")
    done
    local result
    result=$(whiptail --title "$title" --checklist "" \
        $WT_HEIGHT $WT_WIDTH $WT_MENU_HEIGHT "${args[@]}" 3>&1 1>&2 2>&3) || return 1
    # whiptail returns space-separated quoted strings; convert to CSV
    echo "$result" | tr -d '"' | tr ' ' ','
}

# --- Dialogs ---

dlg_connection() {
    local choice
    choice=$(whiptail --title "Connection" --menu "How to connect to the GPS receiver:" \
        $WT_HEIGHT $WT_WIDTH 4 \
        "serial" "Serial device and speed" \
        "config" "Read from satpulse config file" \
        "socket" "Unix domain socket" \
        "clear"  "Clear connection settings" \
        3>&1 1>&2 2>&3) || return 0
    case "$choice" in
        serial)
            local dev speed
            dev=$(whiptail --title "Serial device" \
                --inputbox "Path to serial device (e.g. /dev/ttyUSB0):" \
                8 $WT_WIDTH "$SERIAL_DEVICE" 3>&1 1>&2 2>&3) || return 0
            speed=$(whiptail --title "Host serial speed" \
                --inputbox "Host serial port speed in bits per second:" \
                8 $WT_WIDTH "$DEVICE_SPEED" 3>&1 1>&2 2>&3) || return 0
            if [ -n "$dev" ] && [ -n "$speed" ]; then
                CONN_TYPE="serial"
                SERIAL_DEVICE="$dev"
                DEVICE_SPEED="$speed"
            fi
            ;;
        config)
            local f
            f=$(whiptail --title "Config file" \
                --inputbox "Path to TOML config file (e.g. /etc/satpulse.toml):" \
                8 $WT_WIDTH "$CONFIG_FILE" 3>&1 1>&2 2>&3) || return 0
            if [ -n "$f" ]; then
                CONN_TYPE="config"
                CONFIG_FILE="$f"
            fi
            ;;
        socket)
            local s
            s=$(whiptail --title "Socket" \
                --inputbox "Path to Unix domain socket:" \
                8 $WT_WIDTH "$SOCKET_PATH" 3>&1 1>&2 2>&3) || return 0
            if [ -n "$s" ]; then
                CONN_TYPE="socket"
                SOCKET_PATH="$s"
            fi
            ;;
        clear)
            CONN_TYPE=""
            SERIAL_DEVICE=""
            DEVICE_SPEED=""
            CONFIG_FILE=""
            SOCKET_PATH=""
            ;;
    esac
}

dlg_gnss() {
    local result
    result=$(checklist_csv "GNSS constellations" "$GNSS" \
        GPS   "Global Positioning System (US)" \
        GAL   "Galileo (EU)" \
        BDS   "BeiDou (China)" \
        GLO   "GLONASS (Russia)" \
        QZSS  "Quasi-Zenith (Japan)" \
        NAVIC "NavIC (India)" \
        SBAS  "Satellite-Based Augmentation Systems" \
    ) || return 0
    GNSS="$result"

    if [ -n "$GNSS" ]; then
        result=$(checklist_csv "Frequency bands" "$BAND" \
            L1  "1575.42 MHz (L1 C/A, L1C, E1, B1C, GLONASS L1, B1I)" \
            L2  "1215-1252 MHz" \
            L5  "1176.45 MHz (GPS L5, Galileo E5a, BeiDou B2a)" \
            E5b "1207 MHz (Galileo E5b, BeiDou B2I, GLONASS L3)" \
            E5  "1164-1210 MHz (includes L5 and E5b)" \
            E6  "1260-1300 MHz" \
        ) || return 0
        BAND="$result"

        local elev
        elev=$(whiptail --title "Minimum satellite elevation" \
            --inputbox "Ignore satellites below this elevation in degrees\n(leave empty for receiver default):" \
            9 $WT_WIDTH "$MIN_ELEV" 3>&1 1>&2 2>&3) || return 0
        MIN_ELEV="$elev"
    fi
}

dlg_timemode() {
    local choice
    choice=$(whiptail --title "Time mode" --menu \
        "Static modes assume fixed antenna position for better timing:" \
        $WT_HEIGHT $WT_WIDTH 5 \
        "survey" "Survey to determine antenna position, then static" \
        "fixed"  "Use known fixed antenna position (ECEF)" \
        "mobile" "Position may change (undo survey or fixed)" \
        "clear"  "Clear time mode settings" \
        3>&1 1>&2 2>&3) || return 0
    case "$choice" in
        survey)
            TIME_MODE="survey"
            local t a
            t=$(whiptail --title "Survey duration" \
                --inputbox "Duration of position survey in seconds\n(leave empty for default: 2000):" \
                9 $WT_WIDTH "$SURVEY_TIME" 3>&1 1>&2 2>&3) || return 0
            SURVEY_TIME="$t"
            a=$(whiptail --title "Survey accuracy" \
                --inputbox "Required survey accuracy in meters\n(leave empty for default: 20.0, minimum: 0.001):" \
                9 $WT_WIDTH "$SURVEY_ACC" 3>&1 1>&2 2>&3) || return 0
            SURVEY_ACC="$a"
            ;;
        fixed)
            TIME_MODE="fixed"
            local pos acc
            pos=$(whiptail --title "Fixed antenna position" \
                --inputbox "ECEF coordinates as X,Y,Z in meters\n(e.g. 4000000,3000000,5000000):" \
                9 $WT_WIDTH "$FIXED_POS" 3>&1 1>&2 2>&3) || return 0
            FIXED_POS="$pos"
            acc=$(whiptail --title "Fixed position accuracy" \
                --inputbox "Accuracy of the fixed position in meters\n(leave empty for default: 20.0, minimum: 0.001):" \
                9 $WT_WIDTH "$FIXED_POS_ACC" 3>&1 1>&2 2>&3) || return 0
            FIXED_POS_ACC="$acc"
            ;;
        mobile)
            TIME_MODE="mobile"
            SURVEY_TIME=""
            SURVEY_ACC=""
            FIXED_POS=""
            FIXED_POS_ACC=""
            ;;
        clear)
            TIME_MODE=""
            SURVEY_TIME=""
            SURVEY_ACC=""
            FIXED_POS=""
            FIXED_POS_ACC=""
            ;;
    esac
}

dlg_timepulse() {
    local w
    w=$(whiptail --title "PPS pulse width" \
        --inputbox "Pulse-per-second signal width in seconds\n(0 disables PPS, leave empty for no change):" \
        9 $WT_WIDTH "$PPS_WIDTH" 3>&1 1>&2 2>&3) || return 0
    PPS_WIDTH="$w"

    local d
    d=$(whiptail --title "Antenna cable delay" \
        --inputbox "Compensate for antenna cable signal delay in nanoseconds\n(leave empty for no change):" \
        9 $WT_WIDTH "$ANT_CABLE_DELAY" 3>&1 1>&2 2>&3) || return 0
    ANT_CABLE_DELAY="$d"

    local g
    g=$(whiptail --title "Time GNSS" --menu \
        "Align PPS to this GNSS system time\n(different GNSSs differ by tens of nanoseconds):" \
        $WT_HEIGHT $WT_WIDTH 5 \
        "GPS" "GPS" \
        "GAL" "Galileo" \
        "BDS" "BeiDou" \
        "GLO" "GLONASS" \
        ""    "(no change)" \
        3>&1 1>&2 2>&3) || return 0
    TIME_GNSS="$g"
}

dlg_messages() {
    local choice
    choice=$(whiptail --title "Message output" --menu "Configure receiver message output:" \
        $WT_HEIGHT $WT_WIDTH 8 \
        "protocol" "Output protocol          ${BINARY_NMEA:+[$BINARY_NMEA]}" \
        "pvt"      "Position/velocity/time   ${PVT_OUT:+[$PVT_OUT]}" \
        "sats"     "Satellite information    ${SATS_OUT:+[$SATS_OUT]}" \
        "raw"      "Raw observations         ${RAW_OUT:+[$RAW_OUT]}" \
        "rtcm"     "RTCM 3.x corrections     ${RTCM_OUT:+[$RTCM_OUT]}" \
        "nmea"     "NMEA sentences           ${NMEA_OUT:+[$NMEA_OUT]}" \
        "clear"    "Clear all message settings" \
        3>&1 1>&2 2>&3) || return 0
    case "$choice" in
        protocol)
            local p
            p=$(whiptail --title "Output protocol" --menu "Select output protocol:" \
                $WT_HEIGHT $WT_WIDTH 4 \
                "binary" "Enable binary, disable NMEA" \
                "nmea"   "Enable NMEA, disable binary" \
                ""       "(no change)" \
                3>&1 1>&2 2>&3) || return 0
            BINARY_NMEA="$p"
            ;;
        pvt)
            local result
            result=$(checklist_csv "Position, velocity, and time messages" "$PVT_OUT" \
                pos    "Position (lat, lon, altitude)" \
                vel    "Velocity (North, East, Down)" \
                time   "Time of navigation solution" \
                tp     "Time of PPS pulse" \
                after  "Emit time message after PPS pulse (requires tp)" \
                leap   "Leap second information" \
                survey "Survey-in progress" \
                qual   "Solution quality" \
                epoch  "End of navigation epoch marker" \
                tai    "Prefer TAI rather than UTC" \
                ecef   "Prefer ECEF rather than lat/lon" \
                ptp    "Preset: PTP time source" \
                ntp    "Preset: NTP time source (no PHC)" \
                off    "Turn off PVT messages not selected above" \
            ) || return 0
            PVT_OUT="$result"
            ;;
        sats)
            local result
            result=$(checklist_csv "Satellite information messages" "$SATS_OUT" \
                sat  "Satellite positions (azimuth, elevation per SV)" \
                sig  "Signal details (per signal per SV)" \
                none "Disable all satellite messages" \
            ) || return 0
            SATS_OUT="$result"
            ;;
        raw)
            local result
            result=$(checklist_csv "Raw observation messages" "$RAW_OUT" \
                obs  "Observations/measurements (for RINEX .obs)" \
                nav  "Navigation data (for RINEX .nav)" \
                none "Disable all raw messages" \
            ) || return 0
            RAW_OUT="$result"
            ;;
        rtcm)
            local result
            result=$(checklist_csv "RTCM 3.x correction messages" "$RTCM_OUT" \
                MSM4 "MSM type 4 for all enabled GNSS" \
                MSM7 "MSM type 7 for all enabled GNSS" \
                ARP  "Antenna Reference Point (message 1005)" \
                auto "Auto-select MSM type and ARP" \
                none "Disable all RTCM messages" \
            ) || return 0
            RTCM_OUT="$result"
            if [ -n "$RTCM_OUT" ] && [ "$RTCM_OUT" != "none" ]; then
                local bid
                bid=$(whiptail --title "RTCM reference station ID" \
                    --inputbox "Reference station ID, 0-4095\n(leave empty for no change):" \
                    9 $WT_WIDTH "$RTCM_BASE_ID" 3>&1 1>&2 2>&3) || true
                RTCM_BASE_ID="$bid"
            fi
            ;;
        nmea)
            local result
            result=$(checklist_csv "NMEA sentence types" "$NMEA_OUT" \
                RMC  "Recommended Minimum (position, speed, course, time)" \
                GGA  "Fix data (position, fix quality, satellites used)" \
                GSA  "DOP and active satellites" \
                GSV  "Satellites in view" \
                ZDA  "Time and date" \
                VTG  "Course and speed over ground" \
                GLL  "Geographic position (lat/lon)" \
                none "Disable all NMEA sentences" \
            ) || return 0
            NMEA_OUT="$result"
            ;;
        clear)
            BINARY_NMEA=""
            PVT_OUT=""
            SATS_OUT=""
            RAW_OUT=""
            RTCM_OUT=""
            RTCM_BASE_ID=""
            NMEA_OUT=""
            ;;
    esac
}

dlg_speed() {
    local s
    s=$(whiptail --title "Receiver serial speed" \
        --inputbox "Change the GPS receiver's serial port speed in bps\n(this is the receiver's speed, not the host port speed):" \
        9 $WT_WIDTH "$RECEIVER_SPEED" 3>&1 1>&2 2>&3) || return 0
    RECEIVER_SPEED="$s"
}

dlg_save_reset() {
    local choice
    choice=$(whiptail --title "Save / Reset" --menu "Non-volatile memory operations:" \
        $WT_HEIGHT $WT_WIDTH 7 \
        "save"          "Save this command's changes to NV memory" \
        "save-all"      "Save entire running config to NV memory" \
        "reload"        "Reload config from NV memory (discard unsaved)" \
        "reset"         "Reset receiver (reload + clear position/time/orbits)" \
        "factory-reset" "Restore factory defaults and reset" \
        ""              "(no change)" \
        3>&1 1>&2 2>&3) || return 0
    SAVE_RESET="$choice"
}

dlg_show_command() {
    local cmd
    cmd=$(build_command)
    whiptail --title "Generated command" --msgbox "$cmd" 10 $WT_WIDTH
}

dlg_run_command() {
    if [ -z "$CONN_TYPE" ]; then
        whiptail --title "Error" --msgbox "Connection not configured." 8 $WT_WIDTH
        return 0
    fi
    local cmd
    cmd=$(build_command)
    if whiptail --title "Run command?" --yesno "$cmd" 10 $WT_WIDTH; then
        clear
        echo "Running: $cmd"
        echo
        eval "$cmd"
        local rc=$?
        echo
        if [ $rc -eq 0 ]; then
            echo "Command completed successfully."
        else
            echo "Command exited with status $rc."
        fi
        echo "Press Enter to return to menu."
        read -r
    fi
}

# --- Main menu loop ---

main_menu() {
    while true; do
        local choice
        choice=$(whiptail --title "GPS Receiver Configuration" \
            --menu "" \
            $WT_HEIGHT $WT_WIDTH $WT_MENU_HEIGHT \
            "connection" "$(conn_summary)" \
            "gnss"       "$(gnss_summary)" \
            "timemode"   "$(timemode_summary)" \
            "timepulse"  "$(timepulse_summary)" \
            "messages"   "$(messages_summary)" \
            "speed"      "Receiver serial speed  ${RECEIVER_SPEED:+[${RECEIVER_SPEED} bps]}" \
            "save"       "$(save_summary)" \
            "---"        "---" \
            "show"       "Show command" \
            "run"        "Run command" \
            3>&1 1>&2 2>&3) || break
        case "$choice" in
            connection) dlg_connection ;;
            gnss)       dlg_gnss ;;
            timemode)   dlg_timemode ;;
            timepulse)  dlg_timepulse ;;
            messages)   dlg_messages ;;
            speed)      dlg_speed ;;
            save)       dlg_save_reset ;;
            show)       dlg_show_command ;;
            run)        dlg_run_command ;;
            *)          ;;
        esac
    done
}

# --- Entry point ---

# Check for whiptail
if ! command -v whiptail >/dev/null 2>&1; then
    echo "Error: whiptail is required but not installed." >&2
    echo "Install it with: sudo apt install whiptail" >&2
    exit 1
fi

# If /etc/satpulse.toml exists, offer to use it
if [ -f /etc/satpulse.toml ]; then
    if whiptail --title "Config file found" --yesno \
        "Found /etc/satpulse.toml. Use it for connection settings?" 8 $WT_WIDTH; then
        CONN_TYPE="config"
        CONFIG_FILE="/etc/satpulse.toml"
    fi
fi

main_menu
