# Ntrip push: the daemon forwards RTCM to a remote caster (the fake caster
# run.py starts on SATPULSE_TEST_REMOTE_CASTER_PORT).
[serial]
device = "${SATPULSE_TEST_FIFO}"

[gps]
config = false
vendor = "u-blox"

[[stream.push]]
protocol = "RTCM"

[stream.push.ntrip]
address = "127.0.0.1:${SATPULSE_TEST_REMOTE_CASTER_PORT}"
mountpoint = "RTCM"
password = "smoketest"
