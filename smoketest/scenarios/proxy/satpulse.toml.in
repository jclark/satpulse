# Read-only serial proxies: a TCP listener and a Unix socket, both
# filtered to UBX packets.
[serial]
device = "${SATPULSE_TEST_FIFO}"

[gps]
config = false
vendor = "u-blox"

[[proxy.tcp]]
listen = "127.0.0.1:${SATPULSE_TEST_PROXY_TCP_PORT}"
protocol = "UBX"
readOnly = true

[[proxy.socket]]
path = "${SATPULSE_TEST_PROXY_SOCKET}"
protocol = "UBX"
readOnly = true
